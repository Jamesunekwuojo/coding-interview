{
  "name": "dataroom-assignment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "pnpm typecheck && pnpm build:plugins && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "prettier --check web api-client plugins plugin-sdk shared scripts *.ts *.mjs && eslint web api-client plugins plugin-sdk scripts *.ts *.mjs",
    "format": "prettier --write web api-client plugins plugin-sdk shared scripts *.ts *.mjs",
    "build:plugins": "node scripts/build-plugins.mjs"
  },
  "dependencies": {
    "@biyard/components": "workspace:*",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3"
  }
}
